APP_URL=http://localhost:5173

# =============================================================================
# Database (SQLite / Turso)
# =============================================================================
# For local development (SQLite file):
SQLITE_URL=file:./data/local.db
# For production (Turso):
# SQLITE_URL=libsql://your-database.turso.io?authToken=your-auth-token
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# =============================================================================
# Session
# =============================================================================
# AUTH_SECRET=`openssl rand -base64 32`

# =============================================================================
# SMTP (Email)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# =============================================================================
# AWS S3 (Image & File Storage)
# =============================================================================
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name
# Optional: Custom endpoint for local development (e.g., MinIO, LocalStack)
# S3_ENDPOINT=http://localhost:9000
